#: templates/core/about.html:11
#, python-format
msgid ""
"%(SITE_TAGLINE)s. %(SITE_NAME)s helps families who need blood and willing donors find each other "
"faster than WhatsApp groups and phone calls."
msgstr ""
"%(SITE_TAGLINE)s۔ %(SITE_NAME)s خون کے ضرورت مند خاندانوں اور رضامند ڈونرز کو واٹس ایپ گروپس اور "
"فون کالز سے کہیں تیزی سے ایک دوسرے تک پہنچانے میں مدد دیتا ہے۔"

#: templates/core/about.html:12
