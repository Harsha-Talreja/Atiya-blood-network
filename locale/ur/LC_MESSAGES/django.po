msgid "This field is required."
msgstr "یہ خانہ پُر کرنا ضروری ہے۔"

msgid "Enter a valid email address."
msgstr "درست ای میل ایڈریس لکھیں۔"

msgid "The two password fields didn’t match."
msgstr "دونوں پاس ورڈ ایک جیسے نہیں ہیں۔"

msgid "Enter a whole number."
msgstr "پورا عدد لکھیں۔"

msgid "Enter a number."
msgstr "عدد لکھیں۔"

#, python-format
msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "یقینی بنائیں کہ یہ قدر %(limit_value)s یا اس سے کم ہو۔"

#, python-format
msgid "Ensure this value is greater than or equal to %(limit_value)s."
msgstr "یقینی بنائیں کہ یہ قدر %(limit_value)s یا اس سے زیادہ ہو۔"

#, python-format
msgid "Select a valid choice. %(value)s is not one of the available choices."
msgstr "درست انتخاب چنیں۔ %(value)s دستیاب انتخابات میں شامل نہیں۔"

msgid "Select a valid choice. That choice is not one of the available choices."
msgstr "درست انتخاب چنیں۔ یہ انتخاب دستیاب انتخابات میں شامل نہیں۔"

msgid "Enter a valid date."
msgstr "درست تاریخ لکھیں۔"

msgid "Enter a valid value."
msgstr "درست قدر لکھیں۔"

msgid ""
"Enter a valid username. This value may contain only unaccented lowercase a-z and uppercase A-Z "
"letters, numbers, and @/./+/-/_ characters."
msgstr "درست صارف نام لکھیں۔ اس میں صرف انگریزی حروف (a-z، A-Z)، ہندسے، اور @/./+/-/_ علامات ہو سکتی ہیں۔"

#, python-format
msgid "Ensure this value has at most %(limit_value)d character (it has %(show_value)d)."
msgid_plural "Ensure this value has at most %(limit_value)d characters (it has %(show_value)d)."
msgstr[0] "اس میں زیادہ سے زیادہ %(limit_value)d حرف ہونے چاہییں (اس میں %(show_value)d ہیں)۔"
msgstr[1] "اس میں زیادہ سے زیادہ %(limit_value)d حرف ہونے چاہییں (اس میں %(show_value)d ہیں)۔"

#, python-format
msgid "Ensure this value has at least %(limit_value)d character (it has %(show_value)d)."
msgid_plural "Ensure this value has at least %(limit_value)d characters (it has %(show_value)d)."
msgstr[0] "اس میں کم از کم %(limit_value)d حرف ہونے چاہییں (اس میں %(show_value)d ہیں)۔"
msgstr[1] "اس میں کم از کم %(limit_value)d حرف ہونے چاہییں (اس میں %(show_value)d ہیں)۔"

#, python-format
msgid "This password is too short. It must contain at least %(min_length)d character."
msgid_plural "This password is too short. It must contain at least %(min_length)d characters."
msgstr[0] "پاس ورڈ بہت چھوٹا ہے۔ اس میں کم از کم %(min_length)d حرف ہونے چاہییں۔"
msgstr[1] "پاس ورڈ بہت چھوٹا ہے۔ اس میں کم از کم %(min_length)d حرف ہونے چاہییں۔"

#: accounts/cnic_form.py:39
msgid "Your CNIC number"
msgstr "آپ کا شناختی کارڈ (CNIC) نمبر"

#: accounts/cnic_form.py:43
msgid "Enter all 13 digits of your CNIC."
msgstr "اپنے شناختی کارڈ کے تمام 13 ہندسے درج کریں۔"

#: accounts/cnic_form.py:45
msgid "Enter your CNIC number to continue."
msgstr "آگے بڑھنے کے لیے اپنا شناختی کارڈ نمبر درج کریں۔"

#: accounts/cnic_form.py:56 accounts/identity.py:64
msgid "This CNIC is already used by another account."
msgstr "یہ شناختی کارڈ نمبر پہلے سے کسی اور اکاؤنٹ میں استعمال ہو رہا ہے۔"

#: accounts/forms.py:13 templates/donors/profile.html:75
msgid "Email"
msgstr "ای میل"

#: accounts/forms.py:25 accounts/forms.py:99 templates/donors/profile.html:74
msgid "Username"
msgstr "صارف نام"

#: accounts/forms.py:29
msgid "e.g. ali.raza"
msgstr "مثلاً ali.raza"

#: accounts/forms.py:32 accounts/forms.py:105
msgid "Password"
msgstr "پاس ورڈ"

#: accounts/forms.py:38
msgid "Confirm password"
msgstr "پاس ورڈ دوبارہ لکھیں"

#: accounts/forms.py:46
msgid "That username is already taken. Please choose another."
msgstr "یہ صارف نام پہلے سے لیا جا چکا ہے۔ براہِ کرم کوئی اور چنیں۔"

#: accounts/forms.py:52
msgid "An account with this email already exists. Try logging in instead."
msgstr "اس ای میل سے پہلے ہی اکاؤنٹ موجود ہے۔ لاگ اِن کر کے دیکھیں۔"

#: accounts/forms.py:59
msgid "Remember me on this device"
msgstr "اس ڈیوائس پر مجھے یاد رکھیں"

#: accounts/forms.py:64
msgid "That username and password don't match. Please check them and try again."
msgstr "صارف نام اور پاس ورڈ میل نہیں کھاتے۔ براہِ کرم دوبارہ چیک کر کے کوشش کریں۔"

#: accounts/forms.py:65
msgid "This account is switched off. Please contact an administrator."
msgstr "یہ اکاؤنٹ بند ہے۔ براہِ کرم ایڈمن سے رابطہ کریں۔"

#: accounts/forms.py:66
msgid "This account has been blocked by an admin, so it cannot sign in."
msgstr "اس اکاؤنٹ کو ایڈمن نے بلاک کر دیا ہے، اس لیے یہ لاگ اِن نہیں ہو سکتا۔"

#: accounts/forms.py:67
msgid "Too many wrong attempts. Please wait a few minutes and try again."
msgstr "بہت زیادہ غلط کوششیں۔ براہِ کرم چند منٹ انتظار کر کے دوبارہ کوشش کریں۔"

#: accounts/forms.py:103
msgid "Your username"
msgstr "آپ کا صارف نام"

#: accounts/identity.py:29
msgid ""
"This CNIC belonged to an account that an admin removed, so it cannot be used again. If you think "
"this is a mistake, please contact an admin."
msgstr ""
"یہ شناختی کارڈ ایسے اکاؤنٹ کا تھا جسے ایڈمن نے ہٹا دیا، اس لیے اسے دوبارہ استعمال نہیں کیا جا "
"سکتا۔ اگر آپ کو لگتا ہے کہ یہ غلطی ہے تو براہِ کرم ایڈمن سے رابطہ کریں۔"

#: accounts/views.py:32
msgid "Account created"
msgstr "اکاؤنٹ بن گیا"

#: accounts/views.py:32
#, python-format
msgid "Welcome, %(name)s. Your account is ready."
msgstr "خوش آمدید، %(name)s۔ آپ کا اکاؤنٹ تیار ہے۔"

#: accounts/views.py:71
#, python-format
msgid "Welcome back, %(name)s."
msgstr "واپسی پر خوش آمدید، %(name)s۔"

#: accounts/views.py:80
msgid "You have been logged out."
msgstr "آپ لاگ آؤٹ ہو گئے ہیں۔"

#: blood_requests/forms.py:26 templates/components/dash_panel.html:36 templates/core/home.html:214
msgid "Hospital"
msgstr "ہسپتال"

#: blood_requests/forms.py:35
msgid "Patient's name"
msgstr "مریض کا نام"

#: blood_requests/forms.py:36
msgid "Blood type needed"
msgstr "درکار خون کا گروپ"

#: blood_requests/forms.py:37 templates/blood_requests/detail.html:58
msgid "Units needed"
msgstr "درکار یونٹس"

#: blood_requests/forms.py:38
msgid "How urgent?"
msgstr "کتنی جلدی ہے؟"

#: blood_requests/forms.py:39 templates/blood_requests/detail.html:68
msgid "Contact number"
msgstr "رابطہ نمبر"

#: blood_requests/forms.py:40
msgid "Note for donors"
msgstr "ڈونرز کے لیے نوٹ"

#: blood_requests/forms.py:41
msgid "Why is extra blood needed?"
msgstr "اضافی خون کی ضرورت کیوں ہے؟"

#: blood_requests/forms.py:48
msgid "e.g. Ahmed Khan"
msgstr "مثلاً احمد خان"

#: blood_requests/forms.py:53 donors/forms.py:60
msgid "Enter an 11-digit mobile number that starts with 03, e.g. 03001234567"
msgstr "11 ہندسوں کا موبائل نمبر لکھیں جو 03 سے شروع ہو، مثلاً 03001234567"

#: blood_requests/forms.py:56
msgid "Ward, doctor's name, anything that helps a donor find you"
msgstr "وارڈ، ڈاکٹر کا نام، یا کوئی بھی بات جس سے ڈونر آپ کو ڈھونڈ سکے"

#: blood_requests/forms.py:59
msgid "Who needs the extra blood, and why"
msgstr "اضافی خون کس کو چاہیے اور کیوں"

#: blood_requests/forms.py:72
msgid "Choose the blood type needed."
msgstr "درکار خون کا گروپ چنیں۔"

#: blood_requests/forms.py:77 templates/core/home.html:202
msgid "Choose the hospital"
msgstr "ہسپتال چنیں"

#: blood_requests/forms.py:96
#, python-format
msgid "A single request can ask for at most %(max)s units."
msgstr "ایک درخواست میں زیادہ سے زیادہ %(max)s یونٹس مانگے جا سکتے ہیں۔"

#: blood_requests/forms.py:107
#, python-format
msgid ""
"You asked for %(units)s units, which is more than %(limit)s. Please explain why this much blood "
"is needed, in a sentence or two."
msgstr ""
"آپ نے %(units)s یونٹس مانگے ہیں، جو %(limit)s سے زیادہ ہیں۔ براہِ کرم ایک دو جملوں میں بتائیں کہ "
"اتنا خون کیوں چاہیے۔"

#: blood_requests/forms.py:117
msgid "Please choose a hospital from the list."
msgstr "براہِ کرم فہرست میں سے ہسپتال چنیں۔"

#: blood_requests/forms.py:127
msgid "Why are you reporting this?"
msgstr "آپ اس کی رپورٹ کیوں کر رہے ہیں؟"

#: blood_requests/forms.py:127
msgid "Anything else? (optional)"
msgstr "کچھ اور؟ (اختیاری)"

#: blood_requests/forms.py:129
msgid "Optional details that would help an admin review this"
msgstr "اختیاری تفصیل جو ایڈمن کو جائزہ لینے میں مدد دے"

#: blood_requests/models.py:204
msgid "Verified by admin"
msgstr "ایڈمن نے تصدیق کی"

#: blood_requests/models.py:204
msgid "Verified by hospital"
msgstr "ہسپتال نے تصدیق کی"

#: blood_requests/services.py:35
#, python-format
msgid "You have reached your daily limit of %(limit)s blood requests. Please try again tomorrow."
msgstr "آپ آج کی %(limit)s خون کی درخواستوں کی حد پوری کر چکے ہیں۔ براہِ کرم کل دوبارہ کوشش کریں۔"

#: blood_requests/services.py:205
msgid "Your account is blocked, so you can't offer to help."
msgstr "آپ کا اکاؤنٹ بلاک ہے، اس لیے آپ مدد کی پیشکش نہیں کر سکتے۔"

#: blood_requests/services.py:208
msgid "Register as a donor first so requesters can see your details."
msgstr "پہلے ڈونر کے طور پر رجسٹر ہوں تاکہ درخواست دینے والے آپ کی تفصیل دیکھ سکیں۔"

#: blood_requests/services.py:210
msgid "You can't respond to your own request."
msgstr "آپ اپنی ہی درخواست کا جواب نہیں دے سکتے۔"

#: blood_requests/services.py:212
msgid "This request has already been fulfilled."
msgstr "یہ درخواست پہلے ہی پوری ہو چکی ہے۔"

#: blood_requests/services.py:214
msgid "This request is closed."
msgstr "یہ درخواست بند ہے۔"

#: blood_requests/services.py:216
msgid "This request has expired."
msgstr "اس درخواست کی میعاد ختم ہو چکی ہے۔"

#: blood_requests/services.py:218
msgid "This request hasn't been verified or released yet."
msgstr "اس درخواست کی ابھی تصدیق یا اجازت نہیں ہوئی۔"

#: blood_requests/services.py:222
#, python-format
msgid "Your blood type (%(donor)s) can't be given to a %(patient)s patient."
msgstr "آپ کا خون کا گروپ (%(donor)s) %(patient)s والے مریض کو نہیں دیا جا سکتا۔"

#: blood_requests/services.py:228
#, python-format
msgid ""
"This request is in %(request_city)s, but your donor profile says %(donor_city)s. You can offer to"
" help requests in your own city. If you have moved, update your area on your donor profile."
msgstr ""
"یہ درخواست %(request_city)s میں ہے، لیکن آپ کی ڈونر پروفائل میں %(donor_city)s درج ہے۔ آپ صرف "
"اپنے شہر کی درخواستوں میں مدد کی پیشکش کر سکتے ہیں۔ اگر آپ منتقل ہو گئے ہیں تو اپنی ڈونر پروفائل "
"میں علاقہ بدل لیں۔"

#: blood_requests/services.py:234
msgid "You're marked as unavailable. Turn availability on first."
msgstr "آپ دستیاب نہیں ہیں۔ پہلے دستیابی آن کریں۔"

#: blood_requests/services.py:238
#, python-format
msgid "You're resting after your last donation until %(date)s."
msgstr "آپ پچھلے عطیے کے بعد %(date)s تک آرام کر رہے ہیں۔"

#: blood_requests/services.py:242
msgid "You've already offered to help with this request."
msgstr "آپ اس درخواست میں پہلے ہی مدد کی پیشکش کر چکے ہیں۔"

#: blood_requests/services.py:249
#, python-format
msgid ""
"You've already offered to help %(patient)s. You can offer here once that request is fulfilled or "
"closed, or if you withdraw your offer."
msgstr ""
"آپ پہلے ہی %(patient)s کی مدد کی پیشکش کر چکے ہیں۔ جب وہ درخواست پوری یا بند ہو جائے، یا آپ اپنی "
"پیشکش واپس لے لیں، تب آپ یہاں پیشکش کر سکتے ہیں۔"

#: blood_requests/services.py:297
msgid "You haven't offered to help with this request."
msgstr "آپ نے اس درخواست میں مدد کی پیشکش نہیں کی۔"

#: blood_requests/services.py:299
msgid "This request is already closed, so the offer can't be withdrawn."
msgstr "یہ درخواست پہلے ہی بند ہے، اس لیے پیشکش واپس نہیں لی جا سکتی۔"

#: blood_requests/services.py:338
msgid "A rejected request can't be marked fulfilled."
msgstr "مسترد شدہ درخواست کو “پوری ہو گئی” نہیں لکھا جا سکتا۔"

#: blood_requests/services.py:340
msgid "A donor needs to offer to help before you can mark this fulfilled."
msgstr "اسے “پوری ہو گئی” لکھنے سے پہلے کسی ڈونر کا مدد کی پیشکش کرنا ضروری ہے۔"

#: blood_requests/services.py:366
msgid "This request is already closed, so it can't be verified."
msgstr "یہ درخواست پہلے ہی بند ہے، اس لیے اس کی تصدیق نہیں ہو سکتی۔"

#: blood_requests/tracking.py:45 blood_requests/views.py:298 templates/core/home.html:164
msgid "Request posted"
msgstr "درخواست جمع ہو گئی"

#: blood_requests/tracking.py:46
msgid "The hospital and blood type were recorded."
msgstr "ہسپتال اور خون کا گروپ درج کر لیا گیا۔"

#: blood_requests/tracking.py:51 blood_requests/tracking.py:77 templates/blood_requests/detail.html:52
#: templates/blood_requests/mine.html:33
msgid "Waiting for an admin"
msgstr "ایڈمن کے فیصلے کا انتظار"

#: blood_requests/tracking.py:52
#, python-format
msgid ""
"This asks for %(units)s units, more than the standard limit, so an admin has to approve it before"
" donors can see it."
msgstr ""
"اس میں %(units)s یونٹس مانگے گئے ہیں، جو معیاری حد سے زیادہ ہیں، اس لیے ڈونرز کو دکھانے سے پہلے "
"ایڈمن کی منظوری ضروری ہے۔"

#: blood_requests/tracking.py:56 blood_requests/tracking.py:72
msgid "Not approved"
msgstr "منظور نہیں ہوئی"

#: blood_requests/tracking.py:57
msgid "An admin did not approve the extra units, so donors never saw this request."
msgstr "ایڈمن نے اضافی یونٹس منظور نہیں کیے، اس لیے ڈونرز نے یہ درخواست کبھی نہیں دیکھی۔"

#: blood_requests/tracking.py:60
msgid "Verified by an admin"
msgstr "ایڈمن نے تصدیق کی"

#: blood_requests/tracking.py:60
msgid "Verified by the hospital"
msgstr "ہسپتال نے تصدیق کی"

#: blood_requests/tracking.py:62
msgid "An admin confirmed this request with the hospital, so donors can see it."
msgstr "ایڈمن نے ہسپتال سے اس درخواست کی تصدیق کر لی، اس لیے ڈونرز اسے دیکھ سکتے ہیں۔"

#: blood_requests/tracking.py:63
#, python-format
msgid "%(hospital)s confirmed this request, so donors can see it."
msgstr "%(hospital)s نے اس درخواست کی تصدیق کر دی، اس لیے ڈونرز اسے دیکھ سکتے ہیں۔"

#: blood_requests/tracking.py:67
msgid "Approved by an admin"
msgstr "ایڈمن نے منظور کی"

#: blood_requests/tracking.py:67
msgid "Released by an admin"
msgstr "ایڈمن نے جاری کی"

#: blood_requests/tracking.py:73
#, python-format
msgid "%(hospital)s did not verify it in time and an admin did not approve it, so donors never saw it."
msgstr ""
"%(hospital)s نے وقت پر تصدیق نہیں کی اور ایڈمن نے بھی منظور نہیں کی، اس لیے ڈونرز نے اسے کبھی "
"نہیں دیکھا۔"

#: blood_requests/tracking.py:78
#, python-format
msgid ""
"%(hospital)s did not verify it in time, so an admin will approve or reject it. Donors cannot see "
"it until then."
msgstr ""
"%(hospital)s نے وقت پر تصدیق نہیں کی، اس لیے ایڈمن اسے منظور یا مسترد کرے گا۔ تب تک ڈونرز اسے "
"نہیں دیکھ سکتے۔"

#: blood_requests/tracking.py:83
msgid "Never reached donors"
msgstr "ڈونرز تک نہیں پہنچی"

#: blood_requests/tracking.py:84
msgid "The request closed before it was verified or approved."
msgstr "درخواست تصدیق یا منظوری سے پہلے ہی بند ہو گئی۔"

#: blood_requests/tracking.py:87
msgid "Waiting for the hospital"
msgstr "ہسپتال کا انتظار"

#: blood_requests/tracking.py:88
#, python-format
msgid "If %(hospital)s does not verify it in time, an admin decides whether donors see it."
msgstr "اگر %(hospital)s وقت پر تصدیق نہ کرے تو ایڈمن فیصلہ کرے گا کہ ڈونرز اسے دیکھیں یا نہیں۔"

#: blood_requests/tracking.py:94
msgid "A donor offered to help"
msgstr "ایک ڈونر نے مدد کی پیشکش کی"

#: blood_requests/tracking.py:95
#, python-format
msgid "%(n)s donor said they can donate."
msgid_plural "%(n)s donors said they can donate."
msgstr[0] "%(n)s ڈونر نے کہا کہ وہ خون دے سکتا ہے۔"
msgstr[1] "%(n)s ڈونرز نے کہا کہ وہ خون دے سکتے ہیں۔"

#: blood_requests/tracking.py:99
msgid "Waiting for a donor"
msgstr "ڈونر کا انتظار"

#: blood_requests/tracking.py:100
msgid "Compatible donors nearby can see this request now."
msgstr "قریب کے موزوں ڈونرز اب یہ درخواست دیکھ سکتے ہیں۔"

#: blood_requests/tracking.py:102
msgid "A donor offers to help"
msgstr "ڈونر کی پیشکش"

#: blood_requests/tracking.py:106 blood_requests/tracking.py:120
msgid "Marked fulfilled"
msgstr "پوری ہو گئی"

#: blood_requests/tracking.py:107
msgid "The requester confirmed the blood was arranged."
msgstr "درخواست دینے والے نے تصدیق کی کہ خون کا انتظام ہو گیا۔"

#: blood_requests/tracking.py:109 core/vocab.py:21
msgid "Expired"
msgstr "میعاد ختم"

#: blood_requests/tracking.py:110
msgid "The request ran out of time and is no longer shown."
msgstr "درخواست کا وقت ختم ہو گیا اور اب نظر نہیں آتی۔"

#: blood_requests/tracking.py:112 blood_requests/tracking.py:115 blood_requests/tracking.py:118
#: core/templatetags/core_extras.py:196 templates/blood_requests/detail.html:61
msgid "Closed"
msgstr "بند"

#: blood_requests/tracking.py:113
msgid "The request was closed when the extra units were not approved."
msgstr "اضافی یونٹس منظور نہ ہونے پر درخواست بند کر دی گئی۔"

#: blood_requests/tracking.py:116
msgid "The request was closed because an admin did not approve it."
msgstr "ایڈمن کے منظور نہ کرنے پر درخواست بند کر دی گئی۔"

#: blood_requests/tracking.py:121
msgid "The requester closes the request once blood is arranged."
msgstr "خون کا انتظام ہو جانے پر درخواست دینے والا درخواست بند کرتا ہے۔"

#: blood_requests/views.py:61
msgid ""
"An admin has blocked this account from posting requests and offering to help, usually after "
"reports about it. You can still sign in and see your own history. If you think this is a mistake,"
" contact the site admin."
msgstr ""
"ایڈمن نے اس اکاؤنٹ کو درخواستیں دینے اور مدد کی پیشکش کرنے سے روک دیا ہے، عموماً اس کے بارے میں "
"رپورٹس کے بعد۔ آپ اب بھی لاگ اِن کر کے اپنی ہسٹری دیکھ سکتے ہیں۔ اگر آپ کو لگتا ہے کہ یہ غلطی ہے "
"تو سائٹ ایڈمن سے رابطہ کریں۔"

#: blood_requests/views.py:77
msgid "Most urgent"
msgstr "سب سے فوری"

#: blood_requests/views.py:78
msgid "Newest first"
msgstr "نئی پہلے"

#: blood_requests/views.py:79
msgid "Closing soon"
msgstr "جلد بند ہونے والی"

#: blood_requests/views.py:290
msgid "Sent for review"
msgstr "جائزے کے لیے بھیج دی گئی"

#: blood_requests/views.py:291
#, python-format
msgid ""
"You asked for %(units)s units, which is more than the standard %(limit)s. An admin will read your"
" reason and decide before donors see this request. You can follow it from \"My requests.\""
msgstr ""
"آپ نے %(units)s یونٹس مانگے ہیں، جو معیاری %(limit)s سے زیادہ ہیں۔ ڈونرز کو دکھانے سے پہلے ایڈمن "
"آپ کی وجہ پڑھ کر فیصلہ کرے گا۔ آپ اسے “میری درخواستیں” میں دیکھ سکتے ہیں۔"

#: blood_requests/views.py:299
#, python-format
msgid ""
"%(hospital)s needs to verify this request before donors can see it. You'll be able to track its "
"status from \"My requests.\""
msgstr ""
"ڈونرز کو دکھانے سے پہلے %(hospital)s کو اس درخواست کی تصدیق کرنا ہوگی۔ آپ “میری درخواستیں” میں اس"
" کی صورتحال دیکھ سکیں گے۔"

#: blood_requests/views.py:355
msgid "Only the person who posted this request can mark it fulfilled."
msgstr "صرف درخواست دینے والا ہی اسے “پوری ہو گئی” لکھ سکتا ہے۔"

#: blood_requests/views.py:363
msgid "Marked as fulfilled. Thank you for updating the request."
msgstr "“پوری ہو گئی” درج کر دیا گیا۔ درخواست اپ ڈیٹ کرنے کا شکریہ۔"

#: blood_requests/views.py:385
msgid ""
"Thanks! The requester can now see that you're willing to help. The hospital will do the final "
"medical screening."
msgstr "شکریہ! درخواست دینے والا اب دیکھ سکتا ہے کہ آپ مدد کرنا چاہتے ہیں۔ ہسپتال آخری طبی معائنہ کرے گا۔"

#: blood_requests/views.py:400
msgid "Your offer was withdrawn. The requester has been told, and you can offer to help elsewhere."
msgstr ""
"آپ کی پیشکش واپس لے لی گئی۔ درخواست دینے والے کو بتا دیا گیا ہے، اور آپ کہیں اور مدد کی پیشکش کر "
"سکتے ہیں۔"

#: blood_requests/views.py:412
msgid "Please choose a reason for the report."
msgstr "براہِ کرم رپورٹ کی وجہ چنیں۔"

#: blood_requests/views.py:423
msgid "You've already reported this request. An admin will review it."
msgstr "آپ پہلے ہی اس درخواست کی رپورٹ کر چکے ہیں۔ ایڈمن اس کا جائزہ لے گا۔"

#: blood_requests/views.py:425
msgid "Thanks for the report. An admin will review this request."
msgstr "رپورٹ کا شکریہ۔ ایڈمن اس درخواست کا جائزہ لے گا۔"

#: core/middleware.py:14
msgid "This account has been blocked by an admin, so it cannot be used."
msgstr "اس اکاؤنٹ کو ایڈمن نے بلاک کر دیا ہے، اس لیے اسے استعمال نہیں کیا جا سکتا۔"

#: core/middleware.py:83
msgid "You were logged out after a while without use. Please log in again."
msgstr "کچھ دیر استعمال نہ کرنے پر آپ کو لاگ آؤٹ کر دیا گیا۔ براہِ کرم دوبارہ لاگ اِن کریں۔"

#: blood_requests/services.py
msgid "You are marked as unavailable, so requests are hidden. Turn your availability on to see them."
msgstr "آپ کو غیر دستیاب کے طور پر نشان زد کیا گیا ہے، اس لیے درخواستیں چھپی ہوئی ہیں۔ انہیں دیکھنے کے لیے اپنی دستیابی آن کریں۔"

#: blood_requests/services.py
#, python-format
msgid "You are in your resting period until %(date)s, so requests are hidden. They will appear again when you can donate."
msgstr "آپ %(date)s تک آرام کے دورانیے میں ہیں، اس لیے درخواستیں چھپی ہوئی ہیں۔ جب آپ عطیہ دے سکیں گے تو یہ دوبارہ نظر آئیں گی۔"

#: donors/views.py
msgid "You can record a donation after you offer to help a request. Open a request and tap \"I can help\" first."
msgstr "آپ کسی درخواست میں مدد کی پیشکش کرنے کے بعد عطیہ درج کر سکتے ہیں۔ پہلے کوئی درخواست کھولیں اور \"میں مدد کر سکتا ہوں\" دبائیں۔"

#: templates/donors/profile.html
msgid "After you offer to help a request, you can record your donation here."
msgstr "کسی درخواست میں مدد کی پیشکش کرنے کے بعد آپ اپنا عطیہ یہاں درج کر سکتے ہیں۔"

#: blood_requests
msgid "You told the requester you are at the hospital. Show your name at the hospital desk."
msgstr "آپ نے درخواست دہندہ کو بتایا ہے کہ آپ ہسپتال میں ہیں۔ ہسپتال کے ڈیسک پر اپنا نام دکھائیں۔"

#: blood_requests
msgid "Tell the requester and the hospital that you have reached the hospital?"
msgstr "کیا آپ درخواست دہندہ اور ہسپتال کو بتانا چاہتے ہیں کہ آپ ہسپتال پہنچ گئے ہیں؟"

#: blood_requests
msgid "I've reached the hospital"
msgstr "میں ہسپتال پہنچ گیا ہوں"

#: blood_requests
msgid "At the hospital"
msgstr "ہسپتال میں"

#: blood_requests
#, python-format
msgid "arrived %(ago)s"
msgstr "%(ago)s پہنچا"

#: blood_requests
msgid "Thank you! The requester and the hospital have been told you are there. Show your name at the hospital desk."
msgstr "شکریہ! درخواست دہندہ اور ہسپتال کو بتا دیا گیا ہے کہ آپ وہاں ہیں۔ ہسپتال کے ڈیسک پر اپنا نام دکھائیں۔"

#: blood_requests
msgid "This request is already closed."
msgstr "یہ درخواست پہلے ہی بند ہو چکی ہے۔"

#: blood_requests
msgid "A donor reached the hospital"
msgstr "ایک ڈونر ہسپتال پہنچ گیا"

#: blood_requests
msgid "A donor reaches the hospital"
msgstr "ڈونر ہسپتال پہنچتا ہے"

#: blood_requests
msgid "The donor taps \"I've reached the hospital\" when they get there."
msgstr "ڈونر وہاں پہنچ کر \"میں ہسپتال پہنچ گیا ہوں\" دباتا ہے۔"

#: blood_requests
#, python-format
msgid "%(n)s donor is at the hospital."
msgid_plural "%(n)s donors are at the hospital."
msgstr[0] "%(n)s ڈونر ہسپتال میں ہے۔"
msgstr[1] "%(n)s ڈونرز ہسپتال میں ہیں۔"

#: blood_requests/services.py
msgid "Another donor has already offered to help with this request. If they withdraw, it will open again."
msgstr "ایک اور ڈونر پہلے ہی اس درخواست میں مدد کی پیشکش کر چکا ہے۔ اگر وہ پیشکش واپس لے لے تو یہ دوبارہ کھل جائے گی۔"

#: blood_requests/templates
msgid "Waiting for the hospital to verify"
msgstr "ہسپتال کی تصدیق کا انتظار"

#: templates/blood_requests/detail.html
msgid "This request asks for %(units_needed)s units, which is more than the standard %(unit_limit)s. It stays hidden from donors until the hospital verifies it. If the hospital does not verify it in time, an admin decides."
msgstr "اس درخواست میں %(units_needed)s یونٹس مانگے گئے ہیں، جو معیاری حد %(unit_limit)s سے زیادہ ہیں۔ جب تک ہسپتال تصدیق نہ کرے یہ ڈونرز سے چھپی رہے گی۔ اگر ہسپتال وقت پر تصدیق نہ کرے تو ایڈمن فیصلہ کرے گا۔"

#: templates/blood_requests/detail.html
msgid "Extra units accepted"
msgstr "اضافی یونٹس منظور"

#: templates/blood_requests/detail.html
msgid "The hospital verified this request, so the %(units_needed)s units are accepted."
msgstr "ہسپتال نے اس درخواست کی تصدیق کر دی ہے، اس لیے %(units_needed)s یونٹس منظور ہیں۔"

#: templates/blood_requests/detail.html
msgid "The hospital has to verify this request before donors can see it. If it does not in time, an admin decides. You will see the result here."
msgstr "ڈونرز کے دیکھنے سے پہلے ہسپتال کو اس درخواست کی تصدیق کرنی ہوگی۔ اگر وہ وقت پر نہ کرے تو ایڈمن فیصلہ کرے گا۔ نتیجہ آپ کو یہاں نظر آئے گا۔"

#: templates/hospitals/dashboard.html
msgid "Verifying this request also accepts the extra units. If it is not verified in time, an admin decides."
msgstr "اس درخواست کی تصدیق کرنے سے اضافی یونٹس بھی منظور ہو جاتے ہیں۔ اگر وقت پر تصدیق نہ ہوئی تو ایڈمن فیصلہ کرے گا۔"

#: blood_requests/tracking.py
msgid "This asks for %(units)s units, more than the standard limit. Donors can see it once the hospital verifies it; if it does not in time, an admin decides."
msgstr "اس میں %(units)s یونٹس مانگے گئے ہیں، جو معیاری حد سے زیادہ ہیں۔ ہسپتال کی تصدیق کے بعد ڈونرز اسے دیکھ سکیں گے؛ اگر وہ وقت پر نہ کرے تو ایڈمن فیصلہ کرے گا۔"

#: blood_requests/views.py
msgid "%(hospital)s needs to verify this request before donors can see it. You asked for %(units)s units, more than the standard %(limit)s; if the hospital verifies it, the extra units are accepted. If it does not verify in time, an admin decides. You can follow it from \"My requests.\""
msgstr "ڈونرز کے دیکھنے سے پہلے %(hospital)s کو اس درخواست کی تصدیق کرنی ہوگی۔ آپ نے %(units)s یونٹس مانگے ہیں، جو معیاری حد %(limit)s سے زیادہ ہیں؛ اگر ہسپتال تصدیق کر دے تو اضافی یونٹس منظور ہو جائیں گے۔ اگر وہ وقت پر تصدیق نہ کرے تو ایڈمن فیصلہ کرے گا۔ آپ اسے \"میری درخواستیں\" میں دیکھ سکتے ہیں۔"

#: core/middleware.py:121
msgid "Hospital accounts only use the verification desk. Use a separate account to donate blood."
msgstr "ہسپتال اکاؤنٹس صرف تصدیقی ڈیسک استعمال کرتے ہیں۔ خون عطیہ کرنے کے لیے الگ اکاؤنٹ استعمال کریں۔"

#: core/middleware.py
msgid "Admin accounts only use the admin panel. Use a separate account to donate or ask for blood."
msgstr ""
"ایڈمن اکاؤنٹس صرف ایڈمن پینل استعمال کرتے ہیں۔ عطیہ دینے یا خون مانگنے کے لیے الگ اکاؤنٹ استعمال "
"کریں۔"

